{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "invify-online",
    "source": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/.next/**", "**/.git/**", "**/service-account.json", "**/.secrets/**"],
    "frameworksBackend": {
      "region": "us-central1",
      "runtime": "nodejs20",
      "memory": "1GiB",
      "cpu": 1
    },
    "headers": [
      {
        "source": "/i/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=600" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "hosting": { "port": 3000 },
    "ui": { "enabled": true }
  }
}