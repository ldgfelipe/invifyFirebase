# Env para Cloud Run con secretos (NO commitear; copiar como env.cloudrun.yaml)
# Genera la cuenta de servicio en: Firebase Console > Project Settings > Service accounts
# > "Generate new private key". Pega client_email y private_key (conserva los \n).
# El STRIPE_WEBHOOK_SECRET sale del Dashboard de Stripe > Webhooks (usar signign secret).
FIREBASE_ADMIN_CLIENT_EMAIL: "tu-servicio@invify-online.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY: "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
STRIPE_WEBHOOK_SECRET: "whsec_xxxxxxxxxxxxxxxxxxxxxxxx"