# ============================================================================
# Invify - Variables de entorno
# Copia este archivo a ".env.local" (desarrollo) y completa los valores.
# EN PRODUCCIÓN (Cloud Run): las NEXT_PUBLIC_* se pasan en BUILD; las secretas
# (Stripe, Firebase Admin) se inyectan como env/secrets en tiempo de ejecución.
# NUNCA subas .env.local al repositorio.
# ============================================================================

# --- Firebase Web (cliente) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (servidor / webhook Stripe) ---
# No definas aquí. En Cloud Functions usa la cuenta de servicio del runtime.
# NO uses claves con prefijo reservado (FIREBASE_*, EXT_*, KIT_*, X_GOOGLE_*)
# en archivos .env: Firebase Functions los rechaza.
# Para el seed local: gcloud auth application-default login
FIREBASE_ADMIN_PROJECT_ID=

# --- Stripe (pagos) ---
# Dashboard de Stripe > Developers > API keys (test/live).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Se obtiene al registrar el webhook apuntando a https://<tu-cloud-run>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- App ---
# Desarrollo: http://localhost:3000  |  Producción: https://<tu-dominio>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
